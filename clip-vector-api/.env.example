LOCAL=development
STAGE=v1
LOG_LEVEL=DEBUG
CUSTOM_DOMAIN=FALSE
API_PORT=5000
API_WORKERS=2
CLIP_VENV=/home/shino/Documents/GrupSti/CLIP_ENVIRONMENT

# # Database
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=auth_db
DB_USER=root
DB_PASS=root

# AWS Secrets Manager Configuration
# Use Secrets Manager to retrieve DB credentials in production.
# Credentials come from the host IAM role; DB_NAME above is still required.
AWS_USE_SECRETS_MANAGER=false
AWS_REGION=us-east-1
# Secret name or ARN (an ARN is fetched from its own region)
AWS_DB_CREDENTIALS_SECRET_ID=arn:aws:secretsmanager:us-east-1:<account-id>:secret:<name>


# CLIP Model Configuration (para mejorar precisión de vectores)
# Modelos disponibles: ViT-L-14, ViT-L-14-336 (más preciso), ViT-H-14 (máxima precisión)
CLIP_MODEL_NAME=ViT-L-14                       # Mayor resolución = mejor precisión
CLIP_PRETRAINED=laion2b_s32b_b82k                  # Dataset de entrenamiento
CLIP_USE_FP64=true                                # true = float64
CLIP_OPTIMIZE_INFERENCE=true                       # Optimizaciones de CPU
CLIP_INTERPOLATION=bicubic  

# YOLO Model Configuration (para detección de objetos en imágenes)
YOLO_MODEL_VERSION=yolo12x
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45

# GroundingDINO (detección de objetos en imagenes con prompts)
DINO_CONFIG_PATH=groundingdino/config/GroundingDINO_SwinT_OGC.py
DINO_MODEL_PATH=groundingdino/weights/groundingdino_swint_ogc.pth
DINO_TEXT_PROMPT="object . thing . item . artwork . piece"
DINO_BOX_THRESHOLD=0.35
DINO_TEXT_THRESHOLD=0.25
DINO_MAX_DETECTIONS=100
DINO_MIN_BOX_SIZE=50
DINO_NMS_THRESHOLD=0.45
DINO_MAX_DETECTION_DIMENSION=860
DINO_USE_COMPILE=true  # Habilitar torch.compile

# DINOv3 image embedding model configuration
DINOV3_NORMALIZE=true
DINOV3_BATCH_SIZE=1
DINOV3_NUM_WORKERS=4
DINOV3_MODEL_NAME=facebook/dinov2-large   #facebook/dinov2-base
DINOV3_USE_BETTER_TRANSFORMER=true  # Optimización automática de transformers
DINOV3_USE_COMPILE=true              # torch.compile para optimización del grafo
DINOV3_COMPILE_MODE=default  # Opciones: default, reduce-overhead, max-autotune
DINOV3_USE_HALF_PRECISION=true       # true = FP16 (50% ahorro VRAM, rápido), false = FP32

# DINOv3 ONNX export settings
DINOV3_USE_ONNX=true                # Use ONNX model for inference (requires export first)
DINOV3_ONNX_PROVIDER=tensorrt            # 'auto', 'tensorrt', 'cuda', 'cpu'
DINOV3_USE_FP32_EXPORT=true          # Use FP32 for ONNX export (better quality, default)

# HuggingFace authentication token (if required to download private models)
# WARNING: no debes versionar tokens reales en repositorios públicos.
HF_AUTH_TOKEN=...

# Indica si CUDA (NVIDIA GPU) está disponible para seleccionar device (true/false)
CUDA_AVAILABLE=true
# Authentication
AUTH_BASIC_CREDENTIALS=[{"username": "user", "password": "pass"}, {"username": "admin", "password": "admin"}]


# Cosine Api
COSINE_API_CREDENTIALS=[{"username": "user", "password": "pass"}, {"username": "admin", "password": "admin"}]
COSINE_API_URL=http://localhost:8000
LOAD_FAISS_FROM_DB=/v1/vector/load_from_db

SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=SONAR_TOKEN
