LOCAL=DEV
PY_ENV=DEV
STAGE=v1
LOG_LEVEL=DEBUG
CUSTOM_DOMAIN=FALSE
API_PORT={{ api_port }}
API_WORKERS={{ api_workers }}
CLIP_VENV=/opt/subs-gp/CLIP_ENVIRONMENT

# Authentication
AUTH_BASIC_CREDENTIALS=[{"username": "user", "password": "pass"}, {"username": "admin", "password": "admin"}]

# Aws Configuration
AWS_USE_SECRETS_MANAGER=true
AWS_ACCESS_KEY_ID={{ aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ aws_secret_access_key }}
AWS_SECRET_MANAGER_ENDPOINT=http://localhost:2773/secretsmanager/get?secretId={secretId}
AWS_REGION={{ aws_region }}

# Example: AWS_DB_CREDENTIALS_SECRET_PREFIX_{PY_ENV}, AWS_DB_CREDENTIALS_SECRET_PREFIX_{PY_ENV}
AWS_DB_CREDENTIALS_SECRET_PREFIX={{ aws_db_credentials_prefix }}

# HuggingFace authentication token (if required to download private models)
# WARNING: no debes versionar tokens reales en repositorios públicos.
HF_AUTH_TOKEN={{ hf_auth_token }}

# Cosine Api
COSINE_API_CREDENTIALS=[{"username": "user", "password": "pass"}, {"username": "admin", "password": "admin"}]
COSINE_API_URL=http://localhost:8100
LOAD_FAISS_FROM_DB=/v1/vector/load_from_db

# GroundingDINO (detección de objetos en imagenes con prompts) 
DINO_CONFIG_PATH=groundingdino/config/GroundingDINO_SwinT_OGC.py
DINO_MODEL_PATH=groundingdino/weights/groundingdino_swint_ogc.pth
DINO_TEXT_PROMPT="object . thing . item . artwork . piece . plate . book . cup . building"
DINO_BOX_THRESHOLD=0.35
DINO_TEXT_THRESHOLD=0.25
DINO_MAX_DETECTIONS=100
DINO_MIN_BOX_SIZE=50
DINO_NMS_THRESHOLD=0.45
DINO_MAX_DETECTION_DIMENSION=860
DINO_USE_COMPILE=true 

# DINOv3 image embedding model configuration
DINOV3_NORMALIZE=true
DINOV3_BATCH_SIZE=10
DINOV3_NUM_WORKERS=2
DINOV3_MODEL_NAME=facebook/dinov3-convnext-large-pretrain-lvd1689m
DINOV3_USE_BETTER_TRANSFORMER=true
DINOV3_USE_COMPILE=true    
DINOV3_COMPILE_MODE=default

# Indica si CUDA (NVIDIA GPU) está disponible para seleccionar device (true/false)
CUDA_AVAILABLE=true

# DINOv3 ONNX configuration
DINOV3_USE_FP32_EXPORT=true
DINOV3_USE_ONNX=true
DINOV3_ONNX_PROVIDER=tensorrt

# GroundingDINO ONNX configuration
DINO_USE_ONNX=true
DINO_ONNX_PROVIDER=tensorrt
DINO_PYTORCH_FP16=true