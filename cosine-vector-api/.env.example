LOCAL=development
STAGE=v1
LOG_LEVEL=DEBUG
CUSTOM_DOMAIN=FALSE
API_PORT=8000
API_WORKERS=2
CLIP_VENV=/opt/subs-gp/CLIP_ENVIRONMENT

# Database
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=auth_db
DB_USER=root
DB_PASS=root

# AWS Secrets Manager Configuration
# Use Secrets Manager to retrieve DB credentials in production.
# Credentials come from the host IAM role; DB_NAME above is still required.
AWS_USE_SECRETS_MANAGER=false
AWS_REGION=us-east-1
# Secret name or ARN (an ARN is fetched from its own region)
AWS_DB_CREDENTIALS_SECRET_ID=arn:aws:secretsmanager:us-east-1:<account-id>:secret:<name>

# Authentication
AUTH_BASIC_CREDENTIALS=[{"username": "user", "password": "pass"}, {"username": "admin", "password": "admin"}]

# Image to vector
IMAGE_TO_VECTOR__URL=http://localhost:5000/v1/vector
IMAGE_TO_VECTOR_CREDENTIALS=[{"username": "user", "password": "pass"}, {"username": "admin", "password": "admin"}]

# Faiss
# Must match the embedding size of clip's model (facebook/dinov2-large -> 1024)
VECTOR_DIMENSION=1024
SHARED_MEMORY_NAME=cosine_vector_api_faiss_index_v1
#Type: int in MB
SHARED_MEMORY_SIZE=100

# SonarQube
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=SONAR_TOKEN