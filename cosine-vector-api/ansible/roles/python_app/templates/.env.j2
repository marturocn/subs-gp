LOCAL=DEV
STAGE=v1
LOG_LEVEL=DEBUG
CUSTOM_DOMAIN=FALSE
API_PORT={{ api_port }}
API_WORKERS={{ api_workers }}
CLIP_VENV=/opt/subs-gp/CLIP_ENVIRONMENT

# Aws Configuration
AWS_USE_SECRETS_MANAGER=true
AWS_REGION={{ aws_region }}

# DB credentials: secret name or ARN, fetched with the host IAM role
# (secretsmanager:GetSecretValue)
AWS_DB_CREDENTIALS_SECRET_ID={{ aws_db_credentials_secret_id }}
DB_NAME={{ db_name }}

# Faiss: must match the embedding size of clip's model (facebook/dinov2-large -> 1024)
VECTOR_DIMENSION=1024

# Authentication
AUTH_BASIC_CREDENTIALS=[{"username": "user", "password": "pass"}, {"username": "admin", "password": "admin"}]

# Image to vector
IMAGE_TO_VECTOR__URL=http://localhost:8000/v1/vector
IMAGE_TO_VECTOR_CREDENTIALS=[{"username": "user", "password": "pass"}, {"username": "admin", "password": "admin"}]


